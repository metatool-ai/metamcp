{
  "name": "metamcp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env.local turbo run dev",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:clean": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.11.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "^0.28.1",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "brace-expansion@>=1.0.0 <=1.1.11": "^1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": "^2.0.2",
      "prismjs@<1.30.0": "^1.30.0",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "@modelcontextprotocol/sdk@<1.29.0": "^1.29.0",
      "@trpc/server@>=11.0.0 <11.8.0": "^11.8.0",
      "tar@<7.5.7": "^7.5.7",
      "hono@<4.13.5": "^4.13.8",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "express-rate-limit@<8.2.2": "^8.2.2",
      "ip-address@<10.3.1": "^10.3.1",
      "fast-uri@<3.1.6": "^3.1.6",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "qs@<6.16.0": "^6.16.0",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "defu@<6.1.5": "^6.1.5",
      "js-cookie@<3.0.7": "^3.0.7",
      "lodash@<4.18.0": "^4.18.0",
      "postcss@<8.5.23": "^8.5.23",
      "sharp@<0.35.4": "^0.35.4",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "flatted@<3.4.2": "^3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "ajv@<6.14.0": "^6.14.0",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "brace-expansion@^5": "^5.0.12",
      "vite@^7": "^7.3.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
